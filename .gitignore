# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging / build artefacts
build/
dist/
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Model weights cached locally by fastembed / sentence-transformers.
# These are large and re-downloadable -- never commit them.
.fastembed_cache/
local_cache/
models/

# Secrets
.env
.env.*
!.env.example

# Benchmark output: bench_results/ IS committed on purpose -- the published
# results table is generated from it and must be reproducible/reviewable.
# Scratch runs written elsewhere are not.
bench_results_scratch/
*.tmp
